rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(workspaceId) {
      return get(/databases/$(database)/documents/memberships/$(workspaceId + "_" + request.auth.uid));
    }

    function isMember(workspaceId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/memberships/$(workspaceId + "_" + request.auth.uid));
    }

    function isManager(workspaceId) {
      return isMember(workspaceId) &&
        membership(workspaceId).data.role in ["owner", "admin"];
    }

    function workerPermission(workspaceId, permission) {
      return isMember(workspaceId) &&
        membership(workspaceId).data.role == "member" &&
        (
          !("permissions" in membership(workspaceId).data) ||
          !(permission in membership(workspaceId).data.permissions) ?
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.workerPermissions[permission] == true :
          membership(workspaceId).data.permissions[permission] == true
        );
    }

    function validWorkerPermissions(data) {
      return data is map &&
        data.editDeleteTransactions is bool &&
        data.manageMaterials is bool &&
        data.manageReferencePrices is bool &&
        data.managePaymentMethods is bool &&
        data.manageMerchants is bool;
    }

    function canManageMerchants(workspaceId) {
      return isManager(workspaceId) || workerPermission(workspaceId, "manageMerchants");
    }

    function canManageMaterials(workspaceId) {
      return isManager(workspaceId) || workerPermission(workspaceId, "manageMaterials");
    }

    function canCreateTransactions(workspaceId) {
      return isMember(workspaceId);
    }

    function canEditTransactions(workspaceId) {
      return isManager(workspaceId) || workerPermission(workspaceId, "editDeleteTransactions");
    }

    function isOwner(workspaceId) {
      return isMember(workspaceId) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    function validDeputyAfter(workspaceId, deputyId) {
      return deputyId == null ||
        (
          existsAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + deputyId)) &&
          getAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + deputyId)).data.workspaceId == workspaceId &&
          getAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + deputyId)).data.userId == deputyId &&
          getAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + deputyId)).data.role in ["admin", "member"]
        );
    }

    function validOwnershipTransfer(workspaceId) {
      return request.resource.data.ownerId != resource.data.ownerId &&
        request.resource.data.ownerId != request.auth.uid &&
        existsAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + request.resource.data.ownerId)) &&
        getAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + request.resource.data.ownerId)).data.userId == request.resource.data.ownerId &&
        getAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + request.resource.data.ownerId)).data.role == "owner" &&
        getAfter(/databases/$(database)/documents/memberships/$(workspaceId + "_" + request.auth.uid)).data.role == "admin";
    }

    function validCurrency(value) {
      return value in ["TRY", "USD"];
    }

    function validMerchant(data, workspaceId) {
      return data.workspaceId == workspaceId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.defaultCurrency is string &&
        validCurrency(data.defaultCurrency) &&
        data.status in ["active", "archived"];
    }

    function validMaterial(data, workspaceId) {
      return data.workspaceId == workspaceId &&
        data.name is string &&
        data.name.size() > 0 &&
        data.aliases is list &&
        data.defaultPrice is number &&
        data.defaultPrice >= 0 &&
        data.currency is string &&
        validCurrency(data.currency) &&
        data.active is bool;
    }

    function validTransactionBase(data, workspaceId, merchantId) {
      return data.workspaceId == workspaceId &&
        data.merchantId == merchantId &&
        data.type in ["purchase", "payment"] &&
        data.date is string &&
        data.date.size() == 10 &&
        data.currency is string &&
        validCurrency(data.currency) &&
        data.createdBy is string &&
        data.updatedBy is string;
    }

    function validPurchase(data, workspaceId, merchantId) {
      return validTransactionBase(data, workspaceId, merchantId) &&
        data.type == "purchase" &&
        data.materialNameSnapshot is string &&
        data.materialNameSnapshot.size() > 0 &&
        data.quantity is number &&
        data.quantity > 0 &&
        data.unitPrice is number &&
        data.unitPrice >= 0 &&
        data.total is number &&
        data.total == data.quantity * data.unitPrice;
    }

    function validPayment(data, workspaceId, merchantId) {
      return validTransactionBase(data, workspaceId, merchantId) &&
        data.type == "payment" &&
        data.paymentMethod is string &&
        data.paymentMethod.size() > 0 &&
        data.amount is number &&
        data.amount > 0;
    }

    function validInvitation(data) {
      return data.workspaceId is string &&
        data.inviterId is string &&
        data.role in ["admin", "member"] &&
        data.expiresAt is timestamp &&
        data.expiresAt > request.time &&
        data.acceptedAt == null &&
        data.cancelledAt == null;
    }

    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwner(workspaceId) &&
        validDeputyAfter(workspaceId, request.resource.data.deputyId) &&
        (
          request.resource.data.ownerId == resource.data.ownerId ||
          validOwnershipTransfer(workspaceId)
        );
      allow delete: if false;

      match /merchants/{merchantId} {
        allow read: if isMember(workspaceId);
        allow create: if canManageMerchants(workspaceId) &&
          validMerchant(request.resource.data, workspaceId);
        allow update: if resource.data.workspaceId == workspaceId &&
          validMerchant(request.resource.data, workspaceId) &&
          (
            (
              resource.data.status == "archived" &&
              request.resource.data.status == "active" &&
              isMember(workspaceId)
            ) ||
            (
              canManageMerchants(workspaceId)
            )
          );
        allow delete: if false;

        match /transactions/{transactionId} {
          allow read: if isMember(workspaceId);
          allow create: if canCreateTransactions(workspaceId) &&
            (
              validPurchase(request.resource.data, workspaceId, merchantId) ||
              validPayment(request.resource.data, workspaceId, merchantId)
            );
          allow update: if canEditTransactions(workspaceId) &&
            resource.data.workspaceId == workspaceId &&
            request.resource.data.workspaceId == workspaceId &&
            request.resource.data.merchantId == merchantId &&
            request.resource.data.type == resource.data.type &&
            request.resource.data.createdBy == resource.data.createdBy &&
            (
              validPurchase(request.resource.data, workspaceId, merchantId) ||
              validPayment(request.resource.data, workspaceId, merchantId)
            );
          allow delete: if false;
        }
      }

      match /materials/{materialId} {
        allow read: if isMember(workspaceId);
        allow create, update: if canManageMaterials(workspaceId) &&
          validMaterial(request.resource.data, workspaceId);
        allow delete: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isMember(workspaceId);
        allow create: if isMember(workspaceId) &&
          request.resource.data.workspaceId == workspaceId &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.action in ["created", "updated", "deleted", "archived", "restored"] &&
          (
            request.resource.data.action == "created"
              ? canCreateTransactions(workspaceId)
              : request.resource.data.action == "updated" || request.resource.data.action == "deleted"
                ? canEditTransactions(workspaceId)
                : canManageMerchants(workspaceId)
          );
        allow update, delete: if false;
      }
    }

    match /invitations/{invitationId} {
      allow read: if signedIn();
      allow create: if isManager(request.resource.data.workspaceId) &&
        request.resource.data.inviterId == request.auth.uid &&
        validInvitation(request.resource.data);
      allow update: if signedIn() &&
        (
          (
            resource.data.inviterId == request.auth.uid &&
            isManager(resource.data.workspaceId) &&
            request.resource.data.workspaceId == resource.data.workspaceId
          ) ||
          (
            request.resource.data.workspaceId == resource.data.workspaceId &&
            request.resource.data.role == resource.data.role &&
            request.resource.data.acceptedAt == request.time &&
            request.resource.data.cancelledAt == null &&
            resource.data.acceptedAt == null &&
            resource.data.cancelledAt == null &&
            resource.data.expiresAt > request.time
          )
        );
      allow delete: if false;
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() &&
        (
          resource.data.userId == request.auth.uid ||
          isOwner(resource.data.workspaceId) ||
          isManager(resource.data.workspaceId)
        );
      allow create: if
        (
          signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role == "owner" &&
          exists(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)) &&
          get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.ownerId == request.auth.uid
        ) ||
        (
          signedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.role in ["admin", "member"] &&
          request.resource.data.invitationId is string &&
          exists(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)) &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.workspaceId == request.resource.data.workspaceId &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.role == request.resource.data.role &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.acceptedAt == null &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.cancelledAt == null &&
          get(/databases/$(database)/documents/invitations/$(request.resource.data.invitationId)).data.expiresAt > request.time
        );
      allow update: if signedIn() &&
        isOwner(resource.data.workspaceId) &&
        request.resource.data.workspaceId == resource.data.workspaceId &&
        request.resource.data.userId == resource.data.userId &&
        (
          request.resource.data.role in ["admin", "member"] ||
          (
            request.resource.data.role == "owner" &&
            request.resource.data.userId != request.auth.uid &&
            getAfter(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.ownerId == request.resource.data.userId &&
            getAfter(/databases/$(database)/documents/memberships/$(resource.data.workspaceId + "_" + request.auth.uid)).data.role == "admin"
          )
        ) &&
        (!("permissions" in request.resource.data) || validWorkerPermissions(request.resource.data.permissions));
      allow delete: if signedIn() &&
        isOwner(resource.data.workspaceId) &&
        resource.data.userId != request.auth.uid;
    }
  }
}